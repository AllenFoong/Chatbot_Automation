# 复制这个文件为 backend/.env 再修改。.env 不会进仓库（.gitignore）。
# 开发电脑：Windows 登入（Trusted_Connection），不需要密码。
GPIS_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=GPiS_Dev;Trusted_Connection=yes;TrustServerCertificate=yes;ApplicationIntent=ReadOnly

# 安全检查：连接到的数据库名字必须是这个，否则拒绝读取。
GPIS_EXPECTED_DATABASE=GPiS_Dev

# 本系统的 PostgreSQL（Phase 3）。CHANGE_ME 换成 chatbot 这个账号的密码（只写在 .env）。
# 密码里不要用 @ : / ? # % 这些符号（会被当成网址的一部分）。
DATABASE_URL=postgresql+psycopg://chatbot:CHANGE_ME@localhost:5432/chatbot_dev

# 跑测试用的数据库：测试会清空它，名字必须以 _test 结尾。
TEST_DATABASE_URL=postgresql+psycopg://chatbot:CHANGE_ME@localhost:5432/chatbot_test

# 登录 cookie 只经 https 传送（Phase 4）。开发电脑用 http://localhost，保持 false；上线用 https 时改成 true。
COOKIE_SECURE=false

# ---------- WhatsApp Cloud API（Phase 5）----------
# 开发时只用 Meta 的「测试号码」（D34）。值从 Meta App Dashboard 拿（步骤见 backend/README.md「Phase 5a」）。
# token、secret 只写在 .env，绝不写进仓库或贴到对话里。改了 .env 要重新启动 uvicorn。
# 自己想一串英文字母和数字（Meta 设定 webhook 时要填一样的）
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
# App settings → Basic → App secret
WHATSAPP_APP_SECRET=CHANGE_ME
# WhatsApp → API Setup：Access token（临时的约 24 小时失效）、Phone number ID（测试号码的 ID，不是电话号码）
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
# 只能发给这些号码（逗号分开）。开发时只填自己的手机号码；没填 = 谁都不能发。
WHATSAPP_ALLOWED_RECIPIENTS=
# Graph API 版本（不填 = v26.0）
# WHATSAPP_API_VERSION=v26.0

# AI 回复（Phase 6 才有）。false：病人的新对话直接交给员工（D37）
AI_REPLIES_ENABLED=false
